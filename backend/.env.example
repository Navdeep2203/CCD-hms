# --- Database (either DATABASE_URL or the individual fields) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=hotel_management
DATABASE_USER=hotel_user
DATABASE_PASSWORD=replace-with-your-db-password
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DB_POOL_MIN=1
DB_POOL_MAX=10

# --- Auth (REQUIRED: app refuses to start with a missing/placeholder/short secret) ---
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-generated-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Business rules ---
TAX_RATE=0.12
LOYALTY_UNIT=100

# --- CORS (comma separated, exact origins) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
