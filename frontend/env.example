# Copy this file to ".env" in the frontend folder (it is git-ignored).
# Vite reads these values at BUILD time, so restart "npm run dev" after changing them.

# Base URL of the backend API, including the /api prefix, with no trailing slash.
# Local development:
VITE_API_BASE=http://127.0.0.1:8000/api

# Production example (set this in your hosting platform's settings instead, e.g. Vercel):
# VITE_API_BASE=https://your-backend.onrender.com/api
