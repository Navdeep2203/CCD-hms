# ==============================================================================
# .dockerignore for Vite Frontend
# ==============================================================================

# --- Node Modules (Crucial: prevents massive context transfer and OS-mismatch bugs) ---
**/node_modules/

# --- Local Build Outputs (Let Docker handle the production build) ---
dist/
build/
out/

# --- Environment Secrets & Local Configurations ---
.env
.env.*
*.local

# --- Version Control ---
.git/
.gitignore
.gitattributes

# --- Docker Configurations ---
docker-compose*.yml
.docker

# --- IDEs, Text Editors, & System Files ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Package Manager Logs & Caches ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/
.pnpm-store/

# --- Testing & Code Quality Caches ---
.eslintcache
.prettiercache
coverage/
.vitest/
.playwright/
.cypress/
