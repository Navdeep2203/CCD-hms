# Copy this file to .env for local Docker testing.
# Generate the passwords and secrets using the commands below.
# Do not replace generated secrets with memorable passwords or commit .env.
# For running the backend without Docker, see backend/.env.example.

# --- Database ---
# These values configure both the db container and the backend connection.
# Generate a password with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DATABASE_NAME=hotel_management
DATABASE_USER=hotel_user
DATABASE_PASSWORD=

# --- Authentication ---
# Required: the application rejects missing, placeholder, or short secrets.
# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Local host ports ---
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Optional: lets plain `docker compose up` load both Compose files.
# Uncomment if you want to use the base and test override automatically.
# COMPOSE_FILE=docker-compose.yml:docker-compose.test.yml